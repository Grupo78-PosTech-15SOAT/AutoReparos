# Copie este arquivo para ".env" e preencha os valores antes de rodar "docker compose up".

# Postgres
DB_PASSWORD=troque_esta_senha

# JWT
# Chave RSA privada (PKCS#8, PEM) que assina os JWT RS256 do Cadastros. Gere com:
#   openssl genrsa 2048 | openssl pkcs8 -topk8 -nocrypt | awk 'NF {printf "%s\\n", $0}'
JWT_CHAVE_PRIVADA_PEM="-----BEGIN PRIVATE KEY-----\nCOLE_AQUI_A_CHAVE_PKCS8\n-----END PRIVATE KEY-----"
JWT_ISSUER=http://localhost:8080
# Segredo de X-Chave-Interna (OS e AuthLambda -> Cadastros)
CHAVE_INTERNA=troque_por_uma_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRY_HOURS=2

# Seed user (usuário admin criado no primeiro start)
SEED_USER_EMAIL=admin@autoreparos.com
SEED_USER_PASSWORD=troque_esta_senha

# pgAdmin
PGADMIN_EMAIL=admin@autoreparos.com
PGADMIN_PASSWORD=troque_esta_senha

# SendGrid (envio de e-mail)
SENDGRID_API_KEY=sua_api_key_do_sendgrid
SENDGRID_FROM_EMAIL=remetente@email.com
SENDGRID_FROM_NAME=AutoReparos

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=troque pelo ambiente desejado (Development, Staging, Production)
# Observabilidade em nuvem (New Relic / Datadog) - OPCIONAL.
# Sem estas variaveis o stack local (Jaeger/Loki/Prometheus) funciona normalmente.
NEW_RELIC_LICENSE_KEY=
# Descomente para o OTel Collector tambem exportar para o New Relic:
# OTEL_VENDOR_CONFIG_ARG=--config=/etc/otel-collector-config.vendor.yaml
