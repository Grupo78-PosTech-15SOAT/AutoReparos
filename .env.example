# Copie este arquivo para ".env" e preencha os valores antes de rodar "docker compose up".

# Postgres
DB_PASSWORD=troque_esta_senha

# JWT
JWT_SECRET=troque_por_uma_chave_secreta_com_pelo_menos_32_caracteres
JWT_EXPIRY_HOURS=2

# Seed user (usuário admin criado no primeiro start)
SEED_USER_EMAIL=admin@autoreparos.com
SEED_USER_PASSWORD=troque_esta_senha

# pgAdmin
PGADMIN_EMAIL=admin@autoreparos.com
PGADMIN_PASSWORD=troque_esta_senha

# Aprovação de orçamento (link enviado por e-mail)
APROVACAO_TOKEN_SECRET=troque_por_uma_chave_secreta_com_pelo_menos_32_caracteres

# SendGrid (envio de e-mail)
SENDGRID_API_KEY=sua_api_key_do_sendgrid
SENDGRID_FROM_EMAIL=remetente@email.com
SENDGRID_FROM_NAME=AutoReparos

# Base URL usada nos links de aprovação/recusa enviados por e-mail
# (em dev local, gerada pelo ngrok - ver seção "Configuração do Ngrok")
APP_BASE_URL=https://seu-endereco-ngrok.ngrok-free.app

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=troque pelo ambiente desejado (Development, Staging, Production)