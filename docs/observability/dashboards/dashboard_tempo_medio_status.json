          "datasource": {
            "type": "prometheus",
            "uid": "Prometheus"
          },
          "editorMode": "code",
          "expr": "(sum(increase(autoreparos_ordens_servico_tempo_diagnostico_seconds_sum[30d])) / clamp_min(sum(increase(autoreparos_ordens_servico_tempo_diagnostico_seconds_count[30d])), 1)) / 3600",
